# Copy to `.env.local` (app secrets, git-ignored) and/or `.env` (compose ports).
# Docker Compose reads `.env`; Next.js reads `.env.local`.

# --- Ports ------------------------------------------------------------------
# Dungeon Portal owns this block so it never collides with other local stacks
# (3000/5432/5433 are commonly taken by other projects and by Docker itself).
APP_PORT=3210             # host port for the containerised app -> container 3000
POSTGRES_PORT=5442        # host port for the dev database   -> container 5432
E2E_POSTGRES_PORT=5443    # host port for the throwaway Playwright database
E2E_PORT=3211             # host port Playwright starts `next dev` on

# --- Database ---------------------------------------------------------------
POSTGRES_DB=dungeoncrawler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host-run `npm run dev` / drizzle-kit connect over the published port above.
# (Inside compose the app overrides this with postgres:5432 automatically.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/dungeoncrawler

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
